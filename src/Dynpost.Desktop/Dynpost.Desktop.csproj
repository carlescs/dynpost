<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window on Windows (no effect on Linux/macOS). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The executable is "Dynpost"; the project and namespaces keep their names. -->
    <AssemblyName>Dynpost</AssemblyName>
    <RootNamespace>Dynpost.Desktop</RootNamespace>
    <Product>Dynpost</Product>
    <AssemblyTitle>Dynpost</AssemblyTitle>
    <Description>A simple, git-friendly HTTP client.</Description>
    <ApplicationIcon>Assets/dynpost.ico</ApplicationIcon>
    <ClientRoot>$(MSBuildProjectDirectory)/../Dynpost.Client/</ClientRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window icon at runtime (the embedded ApplicationIcon only covers the Windows .exe). -->
    <Content Include="Assets/dynpost.ico;Assets/dynpost.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <!-- Only for VelopackApp.Build().Run() in Main; updating lives in Infrastructure. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dynpost.Desktop.Tests" />
    <!-- Lets NSubstitute (Castle DynamicProxy) mock internal interfaces in tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dynpost.Application\Dynpost.Application.csproj" />
    <ProjectReference Include="..\Dynpost.Infrastructure\Dynpost.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="BuildAngular" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm run build" />
    <ItemGroup>
      <AngularAssets Include="$(ClientRoot)dist/dynpost-client/browser/**/*" />
      <Content Include="@(AngularAssets)">
        <Link>wwwroot/%(AngularAssets.RecursiveDir)%(AngularAssets.Filename)%(AngularAssets.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
