<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window on Windows (no effect on Linux/macOS). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The executable is "Missive"; the project and namespaces keep their names. -->
    <AssemblyName>Missive</AssemblyName>
    <RootNamespace>Missive.Desktop</RootNamespace>
    <Product>Missive</Product>
    <AssemblyTitle>Missive</AssemblyTitle>
    <Description>A simple, git-friendly HTTP client.</Description>
    <ApplicationIcon>Assets/missive.ico</ApplicationIcon>
    <ClientRoot>$(MSBuildProjectDirectory)/../Missive.Client/</ClientRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window icon at runtime (the embedded ApplicationIcon only covers the Windows .exe). -->
    <Content Include="Assets/missive.ico;Assets/missive.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Missive.Desktop.Tests" />
    <!-- Lets NSubstitute (Castle DynamicProxy) mock internal interfaces in tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Missive.Application\Missive.Application.csproj" />
    <ProjectReference Include="..\Missive.Infrastructure\Missive.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="BuildAngular" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm run build" />
    <ItemGroup>
      <AngularAssets Include="$(ClientRoot)dist/missive-client/browser/**/*" />
      <Content Include="@(AngularAssets)">
        <Link>wwwroot/%(AngularAssets.RecursiveDir)%(AngularAssets.Filename)%(AngularAssets.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
